{
  "name": "kidbot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:widget": "pnpm --filter web-widget build",
    "dev:mcp": "pnpm --filter mcp-server dev",
    "dev:agent": "pnpm --filter agent-service dev",
    "dev": "concurrently -c auto -n WIDGET,MCP,AGENT \"pnpm --filter web-widget dev\" \"pnpm --filter mcp-server dev\" \"pnpm --filter agent-service dev\"",
    "lint": "node ./scripts/run-lint.mjs",
    "smoke:parent-store-redis": "node ./scripts/smoke-parent-store.mjs local",
    "smoke:parent-store-remote": "node ./scripts/smoke-parent-store.mjs remote",
    "smoke:provider-preflight:ci": "node ./scripts/smoke-provider-preflight.mjs --ci-config-check",
    "smoke:provider-preflight": "node ./scripts/smoke-provider-preflight.mjs",
    "smoke:production-mcp-story-panels": "node ./scripts/smoke-production-mcp-story-panels.mjs",
    "smoke:production-widget-dist-preflight": "node ./scripts/smoke-production-widget-dist-preflight.mjs",
    "smoke:production-widget-story-panels": "tsx ./scripts/smoke-production-widget-story-panels.tsx",
    "smoke:railway-provider-roundtrip": "node ./scripts/smoke-railway-provider-roundtrip.mjs",
    "smoke:secured-posture": "node ./scripts/smoke-secured-posture.mjs",
    "typecheck": "node ./scripts/run-typecheck.mjs",
    "test": "node ./scripts/run-test.mjs",
    "test:root": "node ./scripts/run-test.mjs --root-only",
    "test:all": "cross-env CI=1 pnpm -r --if-present run test && pnpm run test:root && pnpm --filter mcp-server run test:compat",
    "verify:local": "cross-env STRICT_VERIFY=1 pnpm run verify:local:strict",
    "verify:local:strict": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm --filter @kidbot/mcp-server run test:compat && pnpm run smoke:provider-preflight:ci && pnpm run smoke:secured-posture"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.34.1",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "vitest": "^1.5.2",
    "@vitest/coverage-v8": "^1.5.2"
  }
}
