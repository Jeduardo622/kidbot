{
  "version": 1,
  "rules": [
    {
      "id": "protected-engineering-surfaces",
      "classification": "protected",
      "patterns": [
        ".agents/**",
        "AGENTS.md",
        ".github/workflows/**",
        ".github/CODEOWNERS",
        "scripts/engineering-policy.mjs",
        "scripts/evaluate-ai-outputs.mjs",
        "scripts/ai-evaluation-baseline.mjs",
        "scripts/ai-evaluation-job-summary.mjs",
        "scripts/update-ai-evaluation-baseline.mjs",
        "evals/baselines/**",
        "scripts/route-task.mjs",
        "scripts/verify-change.mjs",
        "scripts/resolve-harness-base.mjs",
        "scripts/export-harness-classification.mjs",
        "tests/engineering-policy.test.mjs",
        "tests/ai-output-evaluator.test.mjs",
        "tests/specialist-routing.test.mjs",
        "tests/route-task.test.mjs",
        "tests/verify-change.test.mjs",
        "tests/resolve-harness-base.test.mjs",
        "tests/export-harness-classification.test.mjs",
        "tests/engineering-harness-wiring.test.mjs",
        "tests/verification-wiring.test.mjs",
        "apps/agent-service/src/index.ts",
        "apps/mcp-server/src/server.ts",
        "apps/**/src/**/*schema*",
        "apps/**/src/**/schemas/**",
        "apps/**/src/**/*tool*",
        "apps/**/src/**/tools/**",
        "apps/**/src/**/*guardrail*",
        "apps/**/src/**/*safety*",
        "apps/**/src/**/*moderation*",
        "**/migrations/**",
        "supabase/**",
        "evals/**",
        "**/*schema*",
        "**/*storage*",
        "**/*store*",
        "**/*permission*",
        "**/*role*",
        "**/*tenant*",
        "Dockerfile",
        "**/Dockerfile",
        "docker-compose*.yml",
        "railway.json",
        "netlify.toml",
        "**/auth/**",
        "**/*auth*",
        "**/config.js",
        "**/config.ts",
        "**/*config.cjs",
        "**/*config.js",
        "**/*config.mjs",
        "**/*config.ts",
        "**/tsconfig*.json",
        "**/.eslintrc*",
        "**/eslint.config.cjs",
        "**/eslint.config.js",
        "**/eslint.config.mjs",
        "**/.env",
        "**/.env.*",
        "*auth*",
        "config.js",
        "config.ts",
        "*config.cjs",
        "*config.js",
        "*config.mjs",
        "*config.ts",
        "tsconfig*.json",
        ".eslintrc*",
        "eslint.config.cjs",
        "eslint.config.js",
        "eslint.config.mjs",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "requiresHumanReview": true
    },
    {
      "id": "review-only-documentation",
      "classification": "review-only",
      "patterns": ["**/*.md", "*.md"],
      "requiresHumanReview": false
    },
    {
      "id": "standard-repository-content",
      "classification": "standard",
      "patterns": [
        "**/*.cjs", "**/*.css", "**/*.html", "**/*.js", "**/*.json",
        "**/*.jsx", "**/*.mjs", "**/*.scss", "**/*.ts", "**/*.tsx",
        "*.cjs", "*.css", "*.html", "*.js", "*.json", "*.jsx", "*.mjs",
        "*.scss", "*.ts", "*.tsx"
      ],
      "requiresHumanReview": false
    }
  ],
  "verification": {
    "review-only": ["pnpm run test:harness"],
    "standard": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm test",
      "pnpm --filter @kidbot/mcp-server run test:compat"
    ],
    "protected": ["pnpm run verify:local"]
  }
}
