{
  "version": 1,
  "rules": [
    {
      "id": "protected-engineering-surfaces",
      "classification": "protected",
      "patterns": [
        ".github/workflows/**",
        "**/auth/**",
        "**/*auth*",
        "**/config.js",
        "**/config.ts",
        "**/*config.cjs",
        "**/*config.js",
        "**/*config.mjs",
        "**/*config.ts",
        "**/tsconfig*.json",
        "**/.eslintrc*",
        "**/eslint.config.cjs",
        "**/eslint.config.js",
        "**/eslint.config.mjs",
        "**/.env",
        "**/.env.*",
        "*auth*",
        "config.js",
        "config.ts",
        "*config.cjs",
        "*config.js",
        "*config.mjs",
        "*config.ts",
        "tsconfig*.json",
        ".eslintrc*",
        "eslint.config.cjs",
        "eslint.config.js",
        "eslint.config.mjs",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "requiresHumanReview": true
    },
    {
      "id": "review-only-documentation",
      "classification": "review-only",
      "patterns": ["**/*.md", "*.md"],
      "requiresHumanReview": false
    },
    {
      "id": "standard-repository-content",
      "classification": "standard",
      "patterns": [
        "**/*.cjs", "**/*.css", "**/*.html", "**/*.js", "**/*.json",
        "**/*.jsx", "**/*.mjs", "**/*.scss", "**/*.ts", "**/*.tsx",
        "*.cjs", "*.css", "*.html", "*.js", "*.json", "*.jsx", "*.mjs",
        "*.scss", "*.ts", "*.tsx"
      ],
      "requiresHumanReview": false
    }
  ],
  "verification": {
    "review-only": [],
    "standard": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm test",
      "pnpm --filter @kidbot/mcp-server run test:compat"
    ],
    "protected": ["pnpm run verify:local"]
  }
}
