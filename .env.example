OPENAI_API_KEY=
# Required for secured MCP -> agent-service calls. Generate with:
# openssl rand -base64 48
AGENT_SERVICE_TOKEN=
MCP_PORT=3000
AGENT_PORT=4505
# Optional production override for split service deploys, for example Railway.
# Defaults to http://localhost:${AGENT_PORT}
AGENT_BASE_URL=
FALLBACK_WIDGET=0
KIDBOT_LOCAL_DEV=0
RATE_LIMIT_STORE=redis
REDIS_URL=redis://localhost:6379
MCP_REQUEST_CONTROL_STORE=redis
MCP_CALLER_REQUESTS_PER_MINUTE=60
MCP_NETWORK_REQUESTS_PER_MINUTE=120
MCP_GLOBAL_REQUESTS_PER_MINUTE=600
MCP_CALLER_COST_PER_MINUTE=60
MCP_NETWORK_COST_PER_MINUTE=120
MCP_GLOBAL_COST_PER_MINUTE=600
MCP_CALLER_CONCURRENCY=2
MCP_NETWORK_CONCURRENCY=4
MCP_GLOBAL_CONCURRENCY=8
MCP_AGENT_REQUEST_TIMEOUT_MS=45000
PROVIDER_FAILURE_POLICY=503
PROVIDER_TIMEOUT_MS=120000
PROVIDER_RETRIES=1
KIDBOT_OPENAI_IMAGE_MODEL=gpt-image-2
KIDBOT_IMAGE_STORAGE_MODE=local
KIDBOT_IMAGE_STORAGE_DIR=.kidbot/generated-images
KIDBOT_IMAGE_PUBLIC_BASE_URL=/generated-images
KIDBOT_IMAGE_MAX_BYTES=2500000
KIDBOT_IMAGE_TTL_SECONDS=86400
# Optional: set KIDBOT_IMAGE_STORAGE_MODE=supabase to use Supabase Storage.
# In Supabase mode, leave KIDBOT_IMAGE_PUBLIC_BASE_URL empty or set it to:
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
KIDBOT_SUPABASE_URL=
KIDBOT_SUPABASE_SERVICE_ROLE_KEY=
KIDBOT_SUPABASE_IMAGE_BUCKET=kidbot-images
KIDBOT_SUPABASE_IMAGE_PREFIX=story-panels
PARENT_PROFILE_STORE=disabled
# Required when PARENT_PROFILE_STORE=redis. Generate with:
# openssl rand -base64 48
PARENT_AUTH_SECRET=
PARENT_HISTORY_RETENTION_DAYS=30
PARENT_HISTORY_MAX_EVENTS=200
# Manual remote deploy smoke target. Do not include /mcp.
KIDBOT_REMOTE_MCP_URL=
